/*
 * pg_config.h for the Windows x64 MSVC-ABI (clang-cl) frontend build.
 *
 * Generated by the ports CMakeLists.txt from cmake/pg_config.h.in.
 * Values mirror src/tools/msvc/Solution.pm (GenerateFiles) and the
 * meson.build cdata for host_system == 'windows' with OpenSSL enabled.
 * Only defined macros are listed; everything else is "not defined",
 * as the autoconf template's undefined-macro lines would leave it.
 */

#ifndef PG_CONFIG_H
#define PG_CONFIG_H

/* PostgreSQL version (configure.ac AC_INIT) */
#define PACKAGE_NAME "PostgreSQL"
#define PACKAGE_BUGREPORT "pgsql-bugs@lists.postgresql.org"
#define PACKAGE_URL "https://www.postgresql.org/"
#define PACKAGE_VERSION "@PG_VERSION@"
#define PACKAGE_STRING "PostgreSQL @PG_VERSION@"
#define PACKAGE_TARNAME "postgresql"
#define PG_VERSION "@PG_VERSION@"
#define PG_MAJORVERSION "@PG_MAJOR@"
#define PG_MAJORVERSION_NUM @PG_MAJOR@
#define PG_MINORVERSION_NUM @PG_MINOR@
#define PG_VERSION_NUM @PG_VERSION_NUM@
#define PG_VERSION_STR "PostgreSQL @PG_VERSION@, compiled by Visual C++ build " CppAsString2(_MSC_VER) ", 64-bit"

/* Default port and file suffixes */
#define DEF_PGPORT 5432
#define DEF_PGPORT_STR "5432"
#define DLSUFFIX ".dll"
#define PG_KRB_SRVNAM "postgres"
#define CONFIGURE_ARGS ""
#define PG_USE_STDBOOL 1

/* Types and sizes (64-bit Windows: LLP64, long is 32 bits) */
#define PG_INT64_TYPE long long int
#define INT64_MODIFIER "ll"
#define SIZEOF_BOOL 1
#define SIZEOF_LONG 4
#define SIZEOF_SIZE_T 8
#define SIZEOF_VOID_P 8
#define MAXIMUM_ALIGNOF 8
#define MEMSET_LOOP_LIMIT 1024
#define BLCKSZ 8192
#define RELSEG_SIZE 131072
#define XLOG_BLCKSZ 8192
#define WIN32_STACK_RLIMIT 4194304
#define STDC_HEADERS 1
#define inline __inline
#define pg_restrict __restrict

/* Threading and atomics */
#define ENABLE_THREAD_SAFETY 1
#define HAVE_ATOMICS 1
#define HAVE_SPINLOCKS 1
#define USE_WIN32_SEMAPHORES 1
#define USE_WIN32_SHARED_MEMORY 1
#define USE_SSE42_CRC32C_WITH_RUNTIME_CHECK 1

/* Headers */
#define HAVE_MEMORY_H 1
#define HAVE_STDINT_H 1
#define HAVE_STDLIB_H 1
#define HAVE_STRING_H 1
#define HAVE_SYS_STAT_H 1
#define HAVE_SYS_TYPES_H 1
#define HAVE_UNISTD_H 1

/* Library functions and types present with MSVC / UCRT */
#define HAVE_FSEEKO 1
#define HAVE_INET_PTON 1
#define HAVE_INT_TIMEZONE 1
#define HAVE_LOCALE_T 1
#define HAVE_LONG_LONG_INT_64 1
#define HAVE_MBSTOWCS_L 1
#define HAVE_WCSTOMBS_L 1
#define HAVE_SOCKLEN_T 1
#define HAVE_STRNLEN 1
#define HAVE__CONFIGTHREADLOCALE 1
#define HAVE__CPUID 1

/* Declaration checks (0 = not declared on this platform) */
#define HAVE_DECL_FDATASYNC 0
#define HAVE_DECL_F_FULLFSYNC 0
#define HAVE_DECL_LLVMCREATEGDBREGISTRATIONLISTENER 0
#define HAVE_DECL_LLVMCREATEPERFJITEVENTLISTENER 0
#define HAVE_DECL_LLVMGETHOSTCPUNAME 0
#define HAVE_DECL_LLVMGETHOSTCPUFEATURES 0
#define HAVE_DECL_LLVMORCGETSYMBOLADDRESSIN 0
#define HAVE_DECL_MEMSET_S 0
#define HAVE_DECL_POSIX_FADVISE 0
#define HAVE_DECL_PREADV 0
#define HAVE_DECL_PWRITEV 0
#define HAVE_DECL_STRCHRNUL 0
#define HAVE_DECL_STRLCAT 0
#define HAVE_DECL_STRLCPY 0
#define HAVE_DECL_STRNLEN 1
#define HAVE_DECL_TIMINGSAFE_BCMP 0

/* OpenSSL (configure.ac OPENSSL_API_COMPAT; feature macros for 1.1.0+ and 3.x) */
#define USE_OPENSSL 1
#define OPENSSL_API_COMPAT 0x10002000L
#define HAVE_ASN1_STRING_GET0_DATA 1
#define HAVE_BIO_METH_NEW 1
#define HAVE_HMAC_CTX_FREE 1
#define HAVE_HMAC_CTX_NEW 1
#define HAVE_OPENSSL_INIT_SSL 1
#define HAVE_SSL_CTX_SET_CERT_CB 1
#define HAVE_SSL_CTX_SET_NUM_TICKETS 1
#define HAVE_X509_GET_SIGNATURE_INFO 1
#define HAVE_X509_GET_SIGNATURE_NID 1

#endif							/* PG_CONFIG_H */
